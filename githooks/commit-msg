#!/bin/bash

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -1 "$COMMIT_MSG_FILE")

# ASCII only (Cloudflare Pages rejects non-ASCII), excluding Signed-off-by
if grep -v "^Signed-off-by:" "$COMMIT_MSG_FILE" | LC_ALL=C grep -q '[^[:print:][:space:]]'; then
    echo "BLOCKED: Non-ASCII in commit message"
    exit 1
fi

# Conventional commit format: type(scope)?: description (max 100 chars)
CONVENTIONAL_REGEX='^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([a-z0-9_-]+\))?(!)?: .{1,100}$'

if ! echo "$COMMIT_MSG" | grep -qE "$CONVENTIONAL_REGEX"; then
    echo "BLOCKED: Commit message must follow conventional format"
    echo "  Format: type(scope): description"
    echo "  Types: feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert"
    echo "  Example: fix(auth): handle token expiry"
    exit 1
fi

# Check for Co-authored-by trailers
if grep -iE "Co-authored-by:" "$COMMIT_MSG_FILE" > /dev/null 2>&1; then
    echo "BLOCKED: Co-authored-by trailers not allowed"
    exit 1
fi

# Check for DCO (Signed-off-by)
if ! grep -q "^Signed-off-by:" "$COMMIT_MSG_FILE"; then
    echo "BLOCKED: Missing DCO (Signed-off-by)"
    echo "Use: git commit --signoff"
    exit 1
fi

# Verify Signed-off-by name and email match git user.name and user.email
EXPECTED_NAME=$(git config user.name)
EXPECTED_EMAIL=$(git config user.email)
if ! grep -q "^Signed-off-by: ${EXPECTED_NAME} <${EXPECTED_EMAIL}>$" "$COMMIT_MSG_FILE"; then
    echo "BLOCKED: Signed-off-by must match git identity: ${EXPECTED_NAME} <${EXPECTED_EMAIL}>"
    echo "Use: git commit --signoff (do not hardcode the trailer)"
    exit 1
fi

# Check body line length (max 100 chars, excluding Signed-off-by and comments)
if tail -n +2 "$COMMIT_MSG_FILE" | grep -v "^Signed-off-by:" | grep -v "^#" | grep -E "^.{101,}"; then
    echo "BLOCKED: Commit body lines must be <= 100 characters"
    exit 1
fi

exit 0
