#!/bin/bash

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -1 "$COMMIT_MSG_FILE")

# ASCII only (Cloudflare Pages rejects non-ASCII), excluding Signed-off-by
if grep -v "^Signed-off-by:" "$COMMIT_MSG_FILE" | LC_ALL=C grep -q '[^[:print:][:space:]]'; then
    echo "BLOCKED: Non-ASCII in commit message"
    exit 1
fi

# Conventional commit format: type(scope)?: description (max 100 chars)
CONVENTIONAL_REGEX='^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([a-z0-9_-]+\))?(!)?: .{1,100}$'

if ! echo "$COMMIT_MSG" | grep -qE "$CONVENTIONAL_REGEX"; then
    echo "BLOCKED: Commit message must follow conventional format"
    echo "  Format: type(scope): description"
    echo "  Types: feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert"
    echo "  Example: fix(auth): handle token expiry"
    exit 1
fi

# Subject must not end with a period (conventional commits spec rule 7)
if echo "$COMMIT_MSG" | grep -qE '\.$'; then
    echo "BLOCKED: Commit subject must not end with a period"
    exit 1
fi

# BREAKING CHANGE footer must use correct token format (spec rules 12-16)
# Valid separators per spec: ': ' (colon-space) or ' #' (space-hash).
# Token must be uppercase; BREAKING-CHANGE is an accepted alias.
# Only lines starting with the token pattern are checked (anchored at ^).
if grep -iE "^breaking[ -]change(: | #)" "$COMMIT_MSG_FILE" | grep -qvE "^BREAKING[ -]CHANGE(: | #)"; then
    echo "BLOCKED: BREAKING CHANGE footer token must be uppercase"
    echo "  Valid forms: 'BREAKING CHANGE: <description>' or 'BREAKING CHANGE #<value>'"
    exit 1
fi

# Check for Co-authored-by trailers
if grep -iE "Co-authored-by:" "$COMMIT_MSG_FILE" > /dev/null 2>&1; then
    echo "BLOCKED: Co-authored-by trailers not allowed"
    exit 1
fi

# Check for DCO (Signed-off-by)
if ! grep -q "^Signed-off-by:" "$COMMIT_MSG_FILE"; then
    echo "BLOCKED: Missing DCO (Signed-off-by)"
    echo "Use: git commit --signoff"
    exit 1
fi

# Verify Signed-off-by name and email match git user.name and user.email
EXPECTED_NAME=$(git config user.name)
EXPECTED_EMAIL=$(git config user.email)
if ! grep -q "^Signed-off-by: ${EXPECTED_NAME} <${EXPECTED_EMAIL}>$" "$COMMIT_MSG_FILE"; then
    echo "BLOCKED: Signed-off-by must match git identity: ${EXPECTED_NAME} <${EXPECTED_EMAIL}>"
    echo "Use: git commit --signoff (do not hardcode the trailer)"
    exit 1
fi

# Delegate body/footer structure and line-length checks to commitlint.
# commitlint's parser handles RFC-2822 folding correctly; the manual bash
# walk above does not (indented continuation lines after a blank line are
# mis-classified as footer by the bash heuristic).
#
# Uses ~/.config/commitlint as the commitlint home so deps are always
# available even in Rust/non-JS repos. Picks up a repo-local config when
# present; falls back to the shared config in the commitlint home.
COMMITLINT_HOME="$HOME/.config/commitlint"
COMMITLINT_BIN="$COMMITLINT_HOME/node_modules/.bin/commitlint"

if [ ! -x "$COMMITLINT_BIN" ]; then
    echo "WARNING: commitlint not found at $COMMITLINT_BIN; skipping parser-level checks"
    echo "Run: cd ~/.config/commitlint && npm install"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
COMMITLINT_CONFIG="$COMMITLINT_HOME/commitlint.config.cjs"
if [ -n "$REPO_ROOT" ]; then
    for cfg in \
        "$REPO_ROOT/.commitlintrc" \
        "$REPO_ROOT/.commitlintrc.yml" \
        "$REPO_ROOT/.commitlintrc.yaml" \
        "$REPO_ROOT/.commitlintrc.json" \
        "$REPO_ROOT/.commitlintrc.js" \
        "$REPO_ROOT/.commitlintrc.cjs" \
        "$REPO_ROOT/.commitlintrc.mjs" \
        "$REPO_ROOT/commitlint.config.js" \
        "$REPO_ROOT/commitlint.config.cjs" \
        "$REPO_ROOT/commitlint.config.mjs"; do
        if [ -f "$cfg" ]; then
            COMMITLINT_CONFIG="$cfg"
            break
        fi
    done
fi

# --edit reads the file and resolves relative paths against --cwd (repo root).
# Use REPO_ROOT as cwd so git context is correct; the binary is invoked via
# its absolute path so it does not need to be on PATH.
CWD="${REPO_ROOT:-$PWD}"
"$COMMITLINT_BIN" --edit "$COMMIT_MSG_FILE" --cwd "$CWD" --config "$COMMITLINT_CONFIG"
exit $?
