#!/bin/bash
set -euo pipefail

# Build allowlist dynamically from gitconfig files in home directory
ALLOWED_EMAILS=()
for cfg in "$HOME"/.gitconfig*; do
    [[ -f "$cfg" ]] || continue
    while IFS= read -r email; do
        [[ -n "$email" ]] && ALLOWED_EMAILS+=("$email")
    done < <(grep -E '^\s*email\s*=' "$cfg" 2>/dev/null | sed 's/^[^=]*=\s*//' | tr -d ' \t')
done

# Validate we found at least one email
if [[ ${#ALLOWED_EMAILS[@]} -eq 0 ]]; then
    echo "ERROR: No emails found in ~/.gitconfig*"
    exit 1
fi

AUTHOR_EMAIL=$(git config user.email)

# Check author email
if [[ ! " ${ALLOWED_EMAILS[@]} " =~ " ${AUTHOR_EMAIL} " ]]; then
    echo "BLOCKED: Email not in allowlist: $AUTHOR_EMAIL"
    echo "Allowed: ${ALLOWED_EMAILS[*]}"
    exit 1
fi

# Check for Co-authored-by trailers
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [[ -f "$COMMIT_MSG_FILE" ]]; then
    if grep -qiE "Co-authored-by:" "$COMMIT_MSG_FILE"; then
        echo "BLOCKED: Co-authored-by trailers not allowed"
        echo "Remove Co-authored-by lines from commit message"
        exit 1
    fi
fi

exit 0
