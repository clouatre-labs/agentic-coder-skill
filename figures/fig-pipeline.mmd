%% Figure 1: Scout/Guard/Build/Check pipeline for a complex-tier change.
%% Source of truth — edit here, then regenerate:
%%   sh scripts/figures/render-figures.sh
%% Colors: blue = pipeline phase, red = stop / human gate.
graph TD
    Setup[Setup] --> Scout[Scout]
    subgraph Research
        Scout --> Guard[Guard]
    end
    Guard -->|Gate| Plan[Plan]
    Plan --> Build[Build]
    Build -->|Fail: retry once| Build
    Build -->|Pass| Check[Check]
    Check -->|Fail| Stop[Stop & Ask]
    Check -->|Pass| Review[PR Review]

    classDef phase fill:#a5d8ff
    classDef stop fill:#ffc9c9
    class Setup,Scout,Guard,Plan,Build,Check,Review phase
    class Stop stop
